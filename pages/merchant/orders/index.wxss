/* pages/merchant/orders/index.wxss */
.orders-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF9F5 0%, #F7F8FA 15%);
}

/* 订单筛选 */
.tabs {
  display: flex;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF8 100%);
  padding: 24rpx 32rpx;
  gap: 32rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  overflow-x: auto;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 0, 0.06);
}

.tab-item {
  font-size: 30rpx;
  color: #999;
  white-space: nowrap;
  position: relative;
  padding-bottom: 12rpx;
  font-weight: 500;
  transition: all 0.3s;
}

.tab-item.active {
  color: #FF6B00;
  font-weight: 700;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  border-radius: 3rpx;
  box-shadow: 0 4rpx 8rpx rgba(255, 107, 0, 0.3);
}

/* 订单列表 */
.order-list {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.order-card {
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF8 100%);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 0, 0.08);
  border: 2rpx solid #FFE8D9;
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 18rpx;
  border-bottom: 2rpx solid #FFF5F0;
}

.order-no {
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
}

.order-status {
  font-size: 26rpx;
  font-weight: 700;
}

.order-status.status-paid {
  color: #FF9500;
}

.order-status.status-accepted {
  color: #007AFF;
}

.order-status.status-shipped {
  color: #34C759;
}

.order-status.status-completed {
  color: #8E8E93;
}

/* 商品信息 */
.order-products {
  margin-bottom: 24rpx;
}

.product-item {
  display: flex;
  gap: 18rpx;
  margin-bottom: 18rpx;
  padding: 18rpx;
  background: linear-gradient(135deg, #FFF5F0 0%, #FFE8D9 100%);
  border-radius: 16rpx;
}

.product-item:last-child {
  margin-bottom: 0;
}

.product-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 8rpx rgba(255, 107, 0, 0.1);
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.product-spec-qty {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.spec {
  font-size: 24rpx;
  color: #999;
}

.qty {
  font-size: 26rpx;
  color: #FF6B00;
  font-weight: 500;
}

.product-price {
  font-size: 32rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* 收货地址 */
.order-address {
  display: flex;
  gap: 14rpx;
  margin-bottom: 24rpx;
  padding: 18rpx;
  background: linear-gradient(135deg, #FFF5F0 0%, #FFE8D9 100%);
  border-radius: 16rpx;
}

.address-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.address-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.receiver {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.address {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

/* 订单信息 */
.order-info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 18rpx;
  padding: 18rpx;
  background: linear-gradient(135deg, #FFF5F0 0%, #FFE8D9 100%);
  border-radius: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
}

.info-row .label {
  font-size: 26rpx;
  color: #999;
  font-weight: 500;
}

.info-row .value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

/* 订单金额 */
.order-amount {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #FFF5F0;
}

.amount-label {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 600;
}

.amount-value {
  font-size: 40rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* 操作按钮 */
.order-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}

.action-btn {
  width: 160rpx;
  height: 72rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.action-btn.reject {
  background: linear-gradient(135deg, #FFF5F0 0%, #FFE8D9 100%);
  border: 2rpx solid #FFE8D9;
  color: #FF6B00;
}

.action-btn.accept {
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  color: white;
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 0, 0.3);
}

.action-btn.ship {
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  color: white;
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 0, 0.3);
}

.action-btn.complete {
  background: linear-gradient(135deg, #34C759 0%, #30D158 100%);
  color: white;
  box-shadow: 0 6rpx 16rpx rgba(52, 199, 89, 0.3);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 160rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #FF6B00;
  font-weight: 500;
}
