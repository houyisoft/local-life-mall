/* pages/merchant/profile/index.wxss */
.merchant-profile-page {
  min-height: 100vh;
  background: var(--bg-gray);
  padding: 24rpx 0 180rpx;
}

.section-card {
  background: white;
  margin: 0 32rpx 24rpx;
  padding: 32rpx;
  border-radius: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-dark);
  margin-bottom: 32rpx;
}

/* 表单项 */
.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-dark);
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--bg-gray);
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx 24rpx;
  background: var(--bg-gray);
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-picker {
  width: 100%;
}

.picker-value {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--bg-gray);
  border-radius: 12rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.form-hint {
  display: block;
  font-size: 24rpx;
  color: var(--text-gray);
  margin-top: 8rpx;
}

/* 自定义下拉选择器 */
.custom-select {
  position: relative;
  width: 100%;
  z-index: 100;
}

.select-trigger {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--bg-gray);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.3s;
  position: relative;
  z-index: 2;
}

.select-trigger:active {
  border-color: var(--primary);
  background: #f8f8f8;
}

.select-value {
  font-size: 28rpx;
  color: var(--text-dark);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.select-value.placeholder {
  color: var(--text-gray);
}

.select-arrow {
  font-size: 24rpx;
  color: var(--text-gray);
  margin-left: 12rpx;
  flex-shrink: 0;
  transition: transform 0.3s;
}

.select-arrow.up {
  transform: rotate(180deg);
}

.select-dropdown {
  position: absolute;
  top: 96rpx;
  left: 0;
  width: 100%;
  background: white;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
  max-height: 480rpx;
  overflow-y: auto;
  z-index: 1;
  -webkit-overflow-scrolling: touch;
  box-sizing: border-box;
  border: 2rpx solid #e0e0e0;
}

.select-option {
  padding: 28rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f0f0f0;
  transition: background 0.2s;
  min-height: 88rpx;
}

.select-option:last-child {
  border-bottom: none;
}

.select-option:active {
  background: #f5f5f5;
}

.option-name {
  font-size: 28rpx;
  color: var(--text-dark);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.option-check {
  font-size: 32rpx;
  color: var(--primary);
  font-weight: 600;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* 时间行 */
.time-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 头像上传 */
.avatar-upload {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
}

.avatar-btn {
  padding: 16rpx 32rpx;
  background: var(--bg-gray);
  border-radius: 8rpx;
  font-size: 26rpx;
  color: var(--text-dark);
  position: relative;
  z-index: 10;
}

/* 信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: var(--text-gray);
}

.info-value {
  font-size: 28rpx;
  color: var(--text-dark);
}

.status-badge {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  background: rgba(153, 153, 153, 0.1);
  color: #999999;
}

.status-badge.active {
  background: rgba(76, 175, 80, 0.1);
  color: #4CAF50;
}

/* 操作按钮 */
.action-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 24rpx 32rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.action-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.action-btn.primary {
  background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
  color: white;
}

.action-btn.logout {
  background: var(--bg-gray);
  color: #FF0000;
}
