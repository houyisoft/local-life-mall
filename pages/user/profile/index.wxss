/* pages/user/profile/index.wxss */
.profile-page {
  min-height: 100vh;
  background: var(--bg-gray);
  padding-bottom: 32rpx;
}

/* 用户信息卡片 */
.user-card {
  background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
  padding: 64rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid white;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: white;
}

.user-phone {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 订单入口 */
.order-entry {
  background: white;
  margin: 24rpx 32rpx;
  border-radius: 16rpx;
  padding: 32rpx;
}

.entry-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-dark);
}

.entry-more {
  font-size: 24rpx;
  color: var(--text-gray);
}

.entry-tabs {
  display: flex;
  justify-content: space-around;
}

.entry-tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.tab-icon {
  font-size: 48rpx;
}

.tab-label {
  font-size: 24rpx;
  color: var(--text-gray);
}

/* 功能列表 */
.menu-list {
  background: white;
  margin: 0 32rpx 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.menu-icon {
  font-size: 40rpx;
}

.menu-label {
  font-size: 28rpx;
  color: var(--text-dark);
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.menu-badge {
  font-size: 24rpx;
  color: var(--primary);
  background: #FFF5F0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.menu-arrow {
  font-size: 40rpx;
  color: var(--text-gray);
}

/* 退出登录 */
.logout-btn {
  margin: 0 32rpx;
  height: 88rpx;
  background: white;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--danger);
}
