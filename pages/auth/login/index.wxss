/* pages/auth/login/index.wxss */
.login-page {
  height: 100vh;
  background: linear-gradient(135deg, #FFF5F0 0%, #FFE8D9 100%);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 顶部装饰 */
.header-decoration {
  position: relative;
  height: 320rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
  border-radius: 0 0 50% 50% / 0 0 60rpx 60rpx;
  overflow: hidden;
}

.decoration-pattern {
  position: absolute;
  top: -50%;
  right: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 1px, transparent 1px);
  background-size: 40rpx 40rpx;
  animation: rotate 60s linear infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.decoration-circle {
  position: absolute;
  width: 400rpx;
  height: 400rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  top: -120rpx;
  right: -120rpx;
}

.decoration-circle:nth-child(2) {
  width: 280rpx;
  height: 280rpx;
  top: -60rpx;
  right: 80rpx;
}

/* 内容区 */
.content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 48rpx 40rpx;
  position: relative;
  z-index: 1;
  overflow-y: auto;
}

/* Logo区域 */
.logo-section {
  text-align: center;
  margin-bottom: 32rpx;
}

.logo-container {
  width: 100rpx;
  height: 100rpx;
  background: white;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  margin: 0 auto 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 0, 0.2);
}

.app-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-dark);
}

/* 登录表单 */
.login-form {
  width: 100%;
  background: white;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.form-item {
  margin-bottom: 24rpx;
}

.form-input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.form-input-icon {
  position: absolute;
  left: 24rpx;
  font-size: 36rpx;
  color: var(--text-gray);
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx 0 80rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 20rpx;
  font-size: 28rpx;
  background: #FAFAFA;
}

.form-links {
  text-align: center;
  margin: 16rpx 0 20rpx;
}

.form-links .link {
  font-size: 24rpx;
  color: var(--primary);
}

.login-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
  border: none;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 0, 0.3);
}

/* 自营商家选项 */
.merchant-option {
  padding: 0 8rpx;
  margin-bottom: 24rpx;
}

.merchant-option .checkbox-wrapper {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
}

.merchant-label {
  font-size: 26rpx;
  color: var(--text-dark);
}

.merchant-option .checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #CCCCCC;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
  flex-shrink: 0;
  background: white;
}

.merchant-option .checkbox.checked {
  background: var(--primary);
  border-color: var(--primary);
}

.merchant-option .checkbox.checked::after {
  content: '✓';
  color: white;
  font-size: 20rpx;
  font-weight: bold;
}

.divider {
  display: flex;
  align-items: center;
  margin: 32rpx 0 24rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #F0F0F0;
}

.divider-text {
  padding: 0 24rpx;
  font-size: 24rpx;
  color: var(--text-gray);
}

/* 微信登录按钮 */
.quick-login {
  display: flex;
  justify-content: center;
}

.wechat-login-btn {
  width: 100%;
  height: 88rpx;
  background: #07C160;
  border: none;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 28rpx;
  color: white;
  font-weight: 500;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.3);
}

.wechat-login-btn::after {
  border: none;
}

/* 微信图标 */
.wechat-icon {
  width: 40rpx;
  height: 40rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wechat-dot {
  position: absolute;
  width: 16rpx;
  height: 12rpx;
  background: white;
  border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
}

.wechat-dot:first-child {
  left: 0;
  transform: rotate(-15deg);
}

.wechat-dot:last-child {
  right: 0;
  transform: rotate(15deg);
}

/* 协议 */
.agreement {
  font-size: 22rpx;
  color: var(--text-gray);
  text-align: center;
  margin-top: 24rpx;
  line-height: 1.5;
}

.agreement .link {
  color: var(--primary);
}

.checkbox-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.checkbox {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #CCCCCC;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
  flex-shrink: 0;
}

.checkbox.checked {
  background: var(--primary);
  border-color: var(--primary);
}

.checkbox.checked::after {
  content: '✓';
  color: white;
  font-size: 20rpx;
  font-weight: bold;
}
