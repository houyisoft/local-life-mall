<!--pages/user/cart/index.wxml-->
<wxs module="priceFilter">
  // 格式化价格显示（分转元，保留两位小数）
  var formatPrice = function(price) {
    if (price == null || price === '') {
      return '0.00';
    }
    return (price / 100).toFixed(2);
  };
  module.exports.formatPrice = formatPrice;
</wxs>

<view class="cart-page">
  <!-- 购物车列表 -->
  <view class="cart-list" wx:if="{{cartList.length > 0}}">
    <!-- 按商家分组 -->
    <view class="merchant-group" wx:for="{{cartList}}" wx:key="merchantId">
      <!-- 商家头部 -->
      <view class="merchant-header">
        <view class="merchant-checkbox" bindtap="toggleMerchant" data-merchant-id="{{item.merchantId}}">
          <text class="checkbox {{item.selected ? 'checked' : ''}}">{{item.selected ? '✓' : ''}}</text>
        </view>
        <text class="merchant-name">{{item.merchantName}}</text>
      </view>

      <!-- 商品列表 -->
      <view class="cart-items">
        <view class="cart-item" wx:for="{{item.items}}" wx:for-item="cartItem" wx:key="id">
          <!-- 选择框 -->
          <view class="item-checkbox" bindtap="toggleItem" data-id="{{cartItem.id}}">
            <text class="checkbox {{cartItem.selected ? 'checked' : ''}}">{{cartItem.selected ? '✓' : ''}}</text>
          </view>

          <!-- 商品信息 -->
          <image class="item-image" src="{{cartItem.productImage}}" mode="aspectFill" />
          <view class="item-info">
            <view class="item-name">{{cartItem.productName}}</view>
            <view class="item-spec">{{cartItem.spec}}</view>
            <view class="item-footer">
              <text class="item-price">¥{{priceFilter.formatPrice(cartItem.price)}}</text>
              <view class="item-stepper">
                <text class="stepper-btn" bindtap="changeQuantity" data-id="{{cartItem.id}}" data-delta="-1">-</text>
                <text class="stepper-value">{{cartItem.quantity}}</text>
                <text class="stepper-btn" bindtap="changeQuantity" data-id="{{cartItem.id}}" data-delta="1">+</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{cartList.length === 0}}">
    <text class="empty-icon">🛒</text>
    <text class="empty-text">购物车空空如也</text>
    <button class="empty-btn" bindtap="goToHome">去逛逛</button>
  </view>

  <!-- 底部结算栏 -->
  <view class="bottom-bar" wx:if="{{cartList.length > 0}}">
    <view class="select-all" bindtap="toggleSelectAll">
      <text class="checkbox {{allSelected ? 'checked' : ''}}">{{allSelected ? '✓' : ''}}</text>
      <text class="select-text">全选</text>
    </view>
    <view class="bar-right">
      <text class="clear-btn" bindtap="clearCart">清空</text>
      <view class="total-section">
        <text class="total-label">合计：</text>
        <text class="total-price">¥{{priceFilter.formatPrice(totalPrice)}}</text>
      </view>
      <button class="checkout-btn" disabled="{{selectedCount === 0}}" bindtap="goToCheckout">
        结算({{selectedCount}})
      </button>
    </view>
  </view>
</view>
