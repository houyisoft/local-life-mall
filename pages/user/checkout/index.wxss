/* pages/user/checkout/index.wxss */
.checkout-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF9F5 0%, #F7F8FA 15%);
  padding-bottom: 120rpx;
}

/* 收货地址 */
.address-card {
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF8 100%);
  padding: 32rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 20rpx 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 0, 0.08);
  border: 2rpx solid #FFE8D9;
}

.address-icon {
  font-size: 52rpx;
}

.address-info {
  flex: 1;
}

.address-user {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 14rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.user-phone {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.address-detail {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
}

.address-arrow {
  font-size: 48rpx;
  color: #FFD6C2;
}

.address-info.empty {
  flex: 1;
  display: flex;
  align-items: center;
}

.empty-text {
  font-size: 28rpx;
  color: #FF6B00;
  font-weight: 500;
}

/* 配送时间卡片 */
.delivery-time-card {
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF8 100%);
  padding: 32rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 0 24rpx 20rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 0, 0.08);
  border: 2rpx solid #FFE8D9;
}

.card-icon {
  font-size: 52rpx;
}

.time-info {
  flex: 1;
}

.time-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.time-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.time-estimate {
  font-size: 24rpx;
  color: #FF6B00;
  background: linear-gradient(135deg, #FFF5F0 0%, #FFE8D9 100%);
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  font-weight: 500;
}

.arrow {
  font-size: 48rpx;
  color: #FFD6C2;
}

/* 商品清单 */
.goods-card {
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF8 100%);
  padding: 32rpx 28rpx;
  margin: 0 24rpx 20rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 0, 0.08);
  border: 2rpx solid #FFE8D9;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 24rpx;
}

.goods-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.goods-item {
  display: flex;
  gap: 24rpx;
}

.goods-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 0, 0.1);
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.goods-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.goods-spec {
  font-size: 24rpx;
  color: #999;
  background: #FFF5F0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  display: inline-block;
}

.goods-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.goods-price {
  font-size: 32rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.goods-price::before {
  content: '¥';
  font-size: 22rpx;
  margin-right: 2rpx;
}

.goods-quantity {
  font-size: 26rpx;
  color: #999;
  font-weight: 500;
}

/* 备注 */
.remark-card {
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF8 100%);
  padding: 32rpx 28rpx;
  margin: 0 24rpx 20rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 0, 0.08);
  border: 2rpx solid #FFE8D9;
}

.remark-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}

.remark-input {
  width: 100%;
  height: 80rpx;
  background: linear-gradient(135deg, #FFF5F0 0%, #FFE8D9 100%);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  border: 2rpx solid #FFE8D9;
}

/* 价格明细 */
.price-card {
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF8 100%);
  padding: 32rpx 28rpx;
  margin: 0 24rpx 20rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 0, 0.08);
  border: 2rpx solid #FFE8D9;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.price-row:last-child {
  margin-bottom: 0;
  padding-top: 18rpx;
  border-top: 2rpx solid #FFF5F0;
}

.price-label {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.price-value {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

.price-value.discount {
  color: #FF6B00;
  font-weight: 700;
}

/* 底部提交栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF8 100%);
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -8rpx 24rpx rgba(255, 107, 0, 0.1);
  border-top: 3rpx solid #FFE8D9;
}

.total-section {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
  margin-right: 8rpx;
}

.total-price {
  font-size: 44rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.total-price::before {
  content: '¥';
  font-size: 26rpx;
  margin-right: 2rpx;
}

.submit-btn {
  width: 260rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: white;
  border: none;
  box-shadow: 0 10rpx 28rpx rgba(255, 107, 0, 0.35);
}
