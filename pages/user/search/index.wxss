/* pages/user/search/index.wxss */
.search-page {
  min-height: 100vh;
  background: var(--bg-gray);
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  background: white;
}

.search-input-wrap {
  flex: 1;
  height: 64rpx;
  background: var(--bg-gray);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 16rpx;
}

.search-icon {
  font-size: 32rpx;
  color: var(--text-gray);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.clear-icon {
  width: 32rpx;
  height: 32rpx;
  background: #CCCCCC;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: white;
}

.cancel-btn {
  font-size: 28rpx;
  color: var(--text-dark);
}

/* 搜索结果 */
.search-result {
  padding: 24rpx;
}

.product-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.product-item {
  display: flex;
  gap: 24rpx;
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  padding: 16rpx;
}

.product-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 8rpx 0;
}

.product-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-dark);
}

.product-desc {
  font-size: 24rpx;
  color: var(--text-gray);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
}

.product-price {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary);
}

.product-price::before {
  content: '¥';
  font-size: 20rpx;
  margin-right: 2rpx;
}

.product-sales {
  font-size: 24rpx;
  color: var(--text-gray);
}

/* 搜索推荐 */
.search-recommend {
  padding: 32rpx;
}

.history-section {
  margin-bottom: 48rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-dark);
}

.clear-btn {
  font-size: 24rpx;
  color: var(--text-gray);
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.history-item {
  padding: 12rpx 24rpx;
  background: white;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: var(--text-dark);
}

.hot-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.hot-item {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #FFF5F0 0%, #FFE8D9 100%);
  border-radius: 8rpx;
  font-size: 26rpx;
  color: var(--primary);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 160rpx;
  margin-bottom: 32rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-gray);
}
