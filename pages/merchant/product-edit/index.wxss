/* pages/merchant/product-edit/index.wxss */
.product-edit-page {
  min-height: 100vh;
  background: var(--bg-gray);
  padding-bottom: 180rpx;
}

.form-section {
  background: white;
  margin-bottom: 24rpx;
  padding: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-dark);
  margin-bottom: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-action {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: normal;
}

/* 图片上传 */
.image-upload {
  margin-bottom: 16rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.upload-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

.image-delete {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 28rpx;
  line-height: 1;
}

.image-add {
  width: 160rpx;
  height: 160rpx;
  background: var(--bg-gray);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.add-icon {
  font-size: 48rpx;
  color: var(--text-gray);
  line-height: 1;
}

.add-text {
  font-size: 22rpx;
  color: var(--text-gray);
}

/* 表单项 */
.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-dark);
  margin-bottom: 16rpx;
}

.form-label.required::before {
  content: '*';
  color: #FF0000;
  margin-right: 4rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--bg-gray);
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx 24rpx;
  background: var(--bg-gray);
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-picker {
  width: 100%;
}

.picker-value {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--bg-gray);
  border-radius: 12rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.form-hint {
  display: block;
  font-size: 24rpx;
  color: var(--text-gray);
  margin-top: 8rpx;
}

/* 规格编辑 */
.spec-list {
  margin-top: 24rpx;
}

.spec-group {
  background: var(--bg-gray);
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.spec-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.spec-name-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  background: white;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.spec-delete {
  font-size: 26rpx;
  color: #FF0000;
  white-space: nowrap;
}

.spec-values {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.spec-value-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.spec-value-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  background: white;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.spec-value-delete {
  width: 48rpx;
  height: 48rpx;
  background: rgba(255, 0, 0, 0.1);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FF0000;
  font-size: 28rpx;
  line-height: 1;
}

.spec-value-add {
  height: 72rpx;
  background: white;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--primary);
  border: 2rpx dashed var(--primary);
}

/* 标签选择 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  padding: 12rpx 24rpx;
  background: var(--bg-gray);
  border-radius: 8rpx;
  font-size: 26rpx;
  border: 2rpx solid transparent;
}

.tag-item.active {
  background: rgba(255, 107, 0, 0.1);
  border-color: var(--primary);
  color: var(--primary);
}

/* 提交按钮 */
.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 24rpx 32rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: white;
  border: none;
}

/* 分类行 */
.category-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

.add-category-btn {
  flex-shrink: 0;
  width: 120rpx;
  height: 72rpx;
  padding: 0;
  background: var(--bg-gray);
  border-radius: 8rpx;
  font-size: 24rpx;
  color: var(--primary);
  border: none;
  line-height: 72rpx;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-dark);
}

.modal-close {
  font-size: 48rpx;
  color: var(--text-gray);
  line-height: 1;
}

.modal-body {
  padding: 32rpx;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #f0f0f0;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  border: none;
}

.modal-btn.cancel {
  background: var(--bg-gray);
  color: var(--text-dark);
}

.modal-btn.confirm {
  background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
  color: white;
}

/* 自定义下拉选择器 */
.custom-select {
  position: relative;
  width: 100%;
  z-index: 100;
}

.select-trigger {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--bg-gray);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.3s;
  position: relative;
  z-index: 2;
}

.select-trigger:active {
  border-color: var(--primary);
  background: #f8f8f8;
}

.select-value {
  font-size: 28rpx;
  color: var(--text-dark);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.select-value.placeholder {
  color: var(--text-gray);
}

.select-arrow {
  font-size: 24rpx;
  color: var(--text-gray);
  margin-left: 12rpx;
  flex-shrink: 0;
  transition: transform 0.3s;
}

.select-arrow.up {
  transform: rotate(180deg);
}

.select-dropdown {
  position: absolute;
  top: 96rpx;
  left: 0;
  width: 100%;
  background: white;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
  max-height: 480rpx;
  overflow-y: auto;
  z-index: 1;
  -webkit-overflow-scrolling: touch;
  box-sizing: border-box;
  border: 2rpx solid #e0e0e0;
}

.select-option {
  padding: 28rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f0f0f0;
  transition: background 0.2s;
  min-height: 88rpx;
}

.select-option:last-child {
  border-bottom: none;
}

.select-option:active {
  background: #f5f5f5;
}

.select-option.empty {
  justify-content: center;
  padding: 48rpx 24rpx;
}

.option-name {
  font-size: 28rpx;
  color: var(--text-dark);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.option-check {
  font-size: 32rpx;
  color: var(--primary);
  font-weight: 600;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.empty-text {
  font-size: 26rpx;
  color: var(--text-gray);
}
