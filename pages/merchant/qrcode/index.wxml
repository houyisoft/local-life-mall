<!--pages/merchant/qrcode/index.wxml-->
<view class="qrcode-page">
  <!-- 标题 -->
  <view class="page-title">我的二维码</view>

  <!-- 二维码展示区域 -->
  <view class="qrcode-section">
    <image class="qrcode-image" src="{{qrCodeUrl}}" mode="widthFix" wx:if="{{qrCodeUrl}}"/>
    <view class="loading" wx:if="{{loading}}">
      <text class="loading-text">生成中...</text>
    </view>
    <view class="placeholder" wx:if="{{!loading && !qrCodeUrl}}">
      <text class="placeholder-text">点击下方按钮生成二维码</text>
    </view>
  </view>

  <!-- 商铺信息 -->
  <view class="merchant-info" wx:if="{{merchantInfo}}">
    <text class="merchant-name">{{merchantInfo.name}}</text>
    <text class="merchant-desc">扫描二维码即可进入店铺</text>
  </view>

  <!-- 使用说明 -->
  <view class="tips">
    <view class="tip-title">使用说明</view>
    <view class="tip-item">
      <text class="tip-number">1</text>
      <text class="tip-text">点击"生成二维码"按钮</text>
    </view>
    <view class="tip-item">
      <text class="tip-number">2</text>
      <text class="tip-text">长按二维码图片保存到相册</text>
    </view>
    <view class="tip-item">
      <text class="tip-number">3</text>
      <text class="tip-text">打印张贴在店铺显眼位置</text>
    </view>
    <view class="tip-item">
      <text class="tip-number">4</text>
      <text class="tip-text">顾客扫码即可进入您的店铺</text>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="btn-section">
    <button class="btn-generate" bindtap="generateQRCode" wx:if="{{!qrCodeUrl}}" loading="{{loading}}">
      {{loading ? '生成中...' : '生成二维码'}}
    </button>
    <button class="btn-save" bindtap="saveQRCode" wx:if="{{qrCodeUrl}}">保存到相册</button>
    <button class="btn-regenerate" bindtap="regenerateQRCode" wx:if="{{qrCodeUrl}}">重新生成</button>
  </view>
</view>
