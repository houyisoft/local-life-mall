<!--pages/user/address/edit/index.wxml-->
<view class="address-edit-page">
  <form bindsubmit="handleSubmit">
    <!-- 收货人 -->
    <view class="form-item">
      <text class="label">收货人</text>
      <input
        class="input"
        name="userName"
        value="{{formData.userName}}"
        placeholder="请输入收货人姓名"
        bindinput="onInputChange"
        data-field="userName"
        maxlength="20"
      />
    </view>

    <!-- 手机号 -->
    <view class="form-item">
      <text class="label">手机号</text>
      <input
        class="input"
        name="userPhone"
        value="{{formData.userPhone}}"
        placeholder="请输入手机号"
        type="number"
        bindinput="onInputChange"
        data-field="userPhone"
        maxlength="11"
      />
    </view>

    <!-- 地区选择 -->
    <view class="form-item" bindtap="showRegionPicker">
      <text class="label">所在地区</text>
      <picker
        mode="region"
        value="{{[formData.province, formData.city, formData.district]}}"
        bindchange="onRegionChange"
      >
        <view class="region-value {{!regionText ? 'placeholder' : ''}}">
          {{regionText || '请选择省市区'}}
        </view>
      </picker>
      <text class="arrow">›</text>
    </view>

    <!-- 详细地址 -->
    <view class="form-item detail">
      <text class="label">详细地址</text>
      <textarea
        class="textarea"
        name="detail"
        value="{{formData.detail}}"
        placeholder="街道、楼牌号等详细信息"
        bindinput="onInputChange"
        data-field="detail"
        maxlength="200"
      />
    </view>

    <!-- 设为默认 -->
    <view class="default-switch">
      <text class="switch-label">设为默认地址</text>
      <switch
        name="isDefault"
        checked="{{formData.isDefault}}"
        bindchange="onDefaultSwitchChange"
        color="#FF6B00"
      />
    </view>

    <!-- 保存按钮 -->
    <button class="save-btn" formType="submit">保存</button>
  </form>
</view>
