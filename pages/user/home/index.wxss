/* pages/user/home/index.wxss */
.home-page {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #FFF9F5 0%, #F7F8FA 15%);
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  gap: 24rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #FFE8D9;
  border-top-color: #FF6B00;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 0, 0.15);
}

.loading-spinner.small {
  width: 40rpx;
  height: 40rpx;
  border-width: 3rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #FF6B00;
  font-weight: 500;
}

/* 错误状态 */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 48rpx;
  gap: 16rpx;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.error-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.error-hint {
  font-size: 26rpx;
  color: #999;
  text-align: center;
}

/* 顶部定位和搜索栏 */
.top-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF8 100%);
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 0, 0.08);
  z-index: 100;
}

.location-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  border-radius: 40rpx;
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 0, 0.25);
  transition: all 0.3s;
}

.location-btn:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 0, 0.2);
}

.location-icon {
  font-size: 26rpx;
}

.location-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
  max-width: 150rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 28rpx;
  background: linear-gradient(135deg, #FFF5F0 0%, #FFE8D9 100%);
  border-radius: 48rpx;
  transition: all 0.3s;
  border: 2rpx solid transparent;
}

.search-bar:active {
  background: #FFFFFF;
  border-color: #FF6B00;
}

.search-icon {
  font-size: 32rpx;
}

.search-placeholder {
  font-size: 28rpx;
  color: #FF6B00;
  font-weight: 500;
}

/* 滚动内容区 */
.content-scroll {
  flex: 1;
  height: 0;
}

/* 轮播图 */
.banner-section {
  padding: 24rpx;
  padding-bottom: 20rpx;
}

.banner-swiper {
  width: 100%;
  height: 340rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(255, 107, 0, 0.2);
  border: 4rpx solid #FFFFFF;
}

.banner-image {
  width: 100%;
  height: 100%;
  transition: transform 0.3s;
}

.banner-swiper:active .banner-image {
  transform: scale(0.98);
}

/* 快捷入口（商铺类型） */
.quick-access-section {
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF8 100%);
  padding: 36rpx 24rpx 28rpx;
  margin-bottom: 20rpx;
  border-radius: 32rpx;
  margin: 0 24rpx 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 0, 0.06);
}

.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.section-title {
  font-size: 40rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.section-subtitle {
  font-size: 24rpx;
  color: #FF6B00;
  font-weight: 500;
}

.type-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
}

.type-icon-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  width: 20%;
  padding: 10rpx;
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.type-icon-item:active {
  transform: scale(0.9);
}

.type-icon-box {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 0, 0.25);
  transition: all 0.3s;
}

.type-icon-item:active .type-icon-box {
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 0, 0.2);
}

.type-icon {
  font-size: 48rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.1));
}

.type-label {
  font-size: 24rpx;
  color: #333;
  text-align: center;
  font-weight: 500;
}

/* 商铺容器 */
.merchants-container {
  padding-bottom: 120rpx;
}

/* 商铺区块 */
.merchant-section {
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF8 100%);
  margin: 0 24rpx 20rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 0, 0.06);
}

.type-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
  transition: background 0.2s;
}

.type-header:active {
  background: #FFF9F5;
}

.type-title-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex: 1;
}

.type-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 0, 0.2);
}

.type-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.type-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.type-count {
  font-size: 24rpx;
  color: #FF6B00;
  font-weight: 500;
}

.collapse-icon {
  font-size: 24rpx;
  color: #FF6B00;
  padding: 10rpx;
  transition: transform 0.3s;
  font-weight: 600;
}

.collapse-icon.expanded {
  transform: rotate(180deg);
}

/* 商铺内容区 */
.merchant-content {
  animation: slideDown 0.3s ease-out;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 商铺横向滚动 */
.merchants-scroll {
  width: 100%;
  white-space: nowrap;
}

.merchants-row {
  display: inline-flex;
  padding: 0 24rpx 28rpx;
  gap: 20rpx;
}

/* 商铺卡片 */
.merchant-card {
  display: flex;
  width: 540rpx;
  flex-shrink: 0;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF9F5 100%);
  border-radius: 24rpx;
  overflow: hidden;
  border: 3rpx solid #FFE8D9;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 0, 0.08);
}

.merchant-card:active {
  transform: scale(0.97);
  border-color: #FF6B00;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 0, 0.15);
}

.merchant-logo {
  width: 180rpx;
  height: 180rpx;
  background: linear-gradient(135deg, #FFE8D9 0%, #FFD6C2 100%);
  flex-shrink: 0;
}

.merchant-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 24rpx;
  min-height: 180rpx;
}

.merchant-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.merchant-desc {
  font-size: 24rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.6;
}

.merchant-tags {
  display: flex;
  gap: 10rpx;
  margin: 10rpx 0;
}

.merchant-tags .tag {
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  color: #FFFFFF;
  font-size: 22rpx;
  border-radius: 12rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 8rpx rgba(255, 107, 0, 0.15);
}

.merchant-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.merchant-distance,
.merchant-sales {
  font-size: 24rpx;
  color: #FF6B00;
  font-weight: 500;
}

/* 加载提示 */
.loading-tip {
  padding: 40rpx 24rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.loading-tip text {
  font-size: 26rpx;
  color: #FF6B00;
  font-weight: 500;
}

/* 空状态 */
.type-empty {
  padding: 60rpx 24rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.type-empty .empty-icon {
  font-size: 100rpx;
  opacity: 0.6;
}

.type-empty .empty-text {
  font-size: 28rpx;
  color: #FF6B00;
  font-weight: 500;
}

/* 底部安全区 */
.safe-bottom {
  height: constant(safe-area-inset-bottom);
  height: env(safe-area-inset-bottom);
}
