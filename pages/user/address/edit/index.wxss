/* pages/user/address/edit/index.wxss */
.address-edit-page {
  min-height: 100vh;
  background: #F5F5F5;
  padding: 16rpx 24rpx 120rpx;
}

/* 表单项 */
.form-item {
  background: white;
  border-radius: 12rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.form-item.detail {
  flex-direction: column;
  align-items: stretch;
}

.label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  flex-shrink: 0;
  width: 140rpx;
}

.form-item.detail .label {
  margin-bottom: 16rpx;
  width: auto;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.region-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.region-value.placeholder {
  color: #999;
}

.arrow {
  font-size: 48rpx;
  color: #999;
  flex-shrink: 0;
}

.textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  padding: 16rpx;
  background: #F5F5F5;
  border-radius: 8rpx;
  box-sizing: border-box;
}

/* 默认地址开关 */
.default-switch {
  background: white;
  border-radius: 12rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.switch-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 保存按钮 */
.save-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8C00 100%);
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: white;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 0, 0.3);
  margin-top: 48rpx;
}

.save-btn::after {
  border: none;
}
