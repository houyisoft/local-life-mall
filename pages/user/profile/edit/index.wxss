/* pages/user/profile/edit/index.wxss */
.edit-profile-page {
  min-height: 100vh;
  background: var(--bg-gray);
  padding-bottom: 40rpx;
}

/* 顶部标题 */
.header {
  background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
  padding: 80rpx 48rpx 60rpx;
  text-align: center;
  color: white;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.header-subtitle {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 头像区域 */
.avatar-section {
  display: flex;
  justify-content: center;
  margin: -40rpx 0 48rpx;
}

.avatar-wrapper {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.avatar-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid white;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  background: #f5f5f5;
}

.avatar-edit {
  position: absolute;
  bottom: 0;
  right: 0;
  background: var(--primary);
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 4rpx solid white;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.edit-icon {
  font-size: 24rpx;
  line-height: 1;
}

.edit-text {
  font-size: 16rpx;
  line-height: 1;
  margin-top: 2rpx;
  color: white;
}

/* 表单区域 */
.form-section {
  background: white;
  margin: 0 32rpx 32rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.form-item {
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-dark);
  margin-bottom: 24rpx;
}

.form-hint {
  display: block;
  font-size: 22rpx;
  color: var(--text-gray);
  margin-top: 12rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: var(--bg-gray);
  border-radius: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-input-readonly {
  height: 80rpx;
  padding: 0 24rpx;
  background: var(--bg-gray);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--text-gray);
  display: flex;
  align-items: center;
}

/* 性别选择器 */
.gender-selector {
  display: flex;
  gap: 24rpx;
}

.gender-option {
  flex: 1;
  height: 100rpx;
  background: var(--bg-gray);
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 3rpx solid transparent;
  transition: all 0.3s;
}

.gender-option.active {
  border-color: var(--primary);
  background: linear-gradient(135deg, #FFF5F0 0%, #FFE8D9 100%);
}

.gender-icon {
  font-size: 40rpx;
}

.gender-label {
  font-size: 24rpx;
  color: var(--text-gray);
}

.gender-option.active .gender-label {
  color: var(--primary);
  font-weight: 600;
}

/* 按钮区域 */
.button-section {
  padding: 0 32rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: white;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 0, 0.3);
}

.skip-link {
  text-align: center;
  margin-top: 24rpx;
  font-size: 28rpx;
  color: var(--text-gray);
}
