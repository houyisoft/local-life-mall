<!--pages/user/orders/index.wxml-->
<view class="orders-page">
  <!-- 订单筛选 -->
  <view class="tabs">
    <view class="tab-item {{activeTab === 'all' ? 'active' : ''}}" bindtap="switchTab" data-tab="all">全部</view>
    <view class="tab-item {{activeTab === 'paid' ? 'active' : ''}}" bindtap="switchTab" data-tab="paid">待接单</view>
    <view class="tab-item {{activeTab === 'shipped' ? 'active' : ''}}" bindtap="switchTab" data-tab="shipped">配送中</view>
    <view class="tab-item {{activeTab === 'completed' ? 'active' : ''}}" bindtap="switchTab" data-tab="completed">已完成</view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list" wx:if="{{orderList.length > 0}}">
    <view class="order-card" wx:for="{{orderList}}" wx:key="orderId" bindtap="goToOrderDetail" data-id="{{item.orderNo}}">
      <!-- 订单头部 -->
      <view class="order-header">
        <text class="merchant-name">{{item.merchantName}}</text>
        <text class="order-status status-{{item.status}}">
          {{item.statusText}}
        </text>
      </view>

      <!-- 商品列表 -->
      <view class="order-items">
        <view class="order-item" wx:for="{{item.products}}" wx:for-item="product" wx:key="productId">
          <image class="item-image" src="{{product.productImage}}" mode="aspectFill" />
          <view class="item-info">
            <text class="item-name">{{product.productName}}</text>
            <text class="item-spec" wx:if="{{product.spec}}">{{product.spec}}</text>
            <view class="item-footer">
              <text class="item-price">¥{{product.price / 100}}</text>
              <text class="item-quantity">x{{product.quantity}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 订单底部 -->
      <view class="order-footer">
        <view class="order-info">
          <text class="order-time">{{item.createTime}}</text>
          <view class="order-total">
            <text>实付：</text>
            <text class="total-price">¥{{item.actualPrice / 100}}</text>
          </view>
        </view>
        <view class="order-actions">
          <button class="action-btn secondary" wx:if="{{item.status === 'pending'}}" catchtap="cancelOrder" data-id="{{item.orderNo}}">取消订单</button>
          <button class="action-btn primary" wx:if="{{item.status === 'shipped'}}" catchtap="confirmReceipt" data-id="{{item.orderNo}}">确认收货</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{orderList.length === 0 && !loading}}">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无订单</text>
  </view>
</view>
