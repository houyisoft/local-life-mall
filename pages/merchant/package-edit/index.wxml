<!--pages/merchant/package-edit/index.wxml-->
<view class="package-edit-page">
  <!-- 套餐图片 -->
  <view class="form-section">
    <view class="section-title">套餐图片</view>
    <view class="image-upload">
      <view class="image-item" wx:if="{{image}}">
        <image class="upload-image" src="{{image}}" mode="aspectFill" />
        <view class="image-delete" catchtap="deleteImage">×</view>
      </view>
      <view class="image-add" bindtap="chooseImage" wx:if="{{!image}}">
        <text class="add-icon">+</text>
        <text class="add-text">上传图片</text>
      </view>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="form-section">
    <view class="section-title">基本信息</view>
    <view class="form-item">
      <text class="form-label required">套餐名称</text>
      <input class="form-input" placeholder="请输入套餐名称" value="{{name}}" bindinput="onNameInput" maxlength="50" />
    </view>

    <view class="form-item">
      <text class="form-label">套餐描述</text>
      <textarea class="form-textarea" placeholder="请输入套餐描述" value="{{desc}}" bindinput="onDescInput" maxlength="200" />
    </view>
  </view>

  <!-- 价格库存 -->
  <view class="form-section">
    <view class="section-title">价格库存</view>
    <view class="form-item">
      <text class="form-label required">套餐价格（元）</text>
      <input class="form-input" type="digit" placeholder="请输入套餐价格" value="{{price}}" bindinput="onPriceInput" />
    </view>

    <view class="form-item">
      <text class="form-label">原价（元）</text>
      <input class="form-input" type="digit" placeholder="请输入原价" value="{{originalPrice}}" bindinput="onOriginalPriceInput" />
    </view>

    <view class="form-item">
      <text class="form-label required">库存数量</text>
      <input class="form-input" type="number" placeholder="请输入库存数量" value="{{stock}}" bindinput="onStockInput" />
    </view>
  </view>

  <!-- 套餐内容 -->
  <view class="form-section">
    <view class="section-title">
      <text>套餐内容</text>
      <text class="section-action" bindtap="addPackageItem">+ 添加商品</text>
    </view>
    <view class="package-items">
      <view class="package-item" wx:for="{{items}}" wx:key="index">
        <view class="item-header">
          <text class="item-index">商品{{index + 1}}</text>
          <text class="item-delete" catchtap="deletePackageItem" data-index="{{index}}">删除</text>
        </view>
        <view class="item-row">
          <text class="item-label">选择商品</text>
          <view class="custom-select-wrapper" catchtap="toggleProductDropdown" data-index="{{index}}">
            <view class="select-trigger">
              <text class="select-value {{item.productName ? '' : 'placeholder'}}">{{item.productName || '请选择商品'}}</text>
              <text class="select-arrow {{item.showProductDropdown ? 'up' : ''}}">▼</text>
            </view>
            <view class="select-dropdown" wx:if="{{item.showProductDropdown}}" catchtap="stopPropagation">
              <view class="select-option" wx:for="{{products}}" wx:for-item="product" wx:for-index="productIndex" wx:key="id" bindtap="selectProduct" data-item-index="{{index}}" data-product-index="{{productIndex}}">
                <text class="option-name">{{product.name}}</text>
                <text class="option-check" wx:if="{{item.productId === product.id}}">✓</text>
              </view>
              <view class="select-option empty" wx:if="{{products.length === 0}}">
                <text class="empty-text">暂无已上架商品</text>
              </view>
            </view>
          </view>
        </view>
        <view class="item-row">
          <text class="item-label">数量</text>
          <!-- 数量选择器 -->
          <view class="quantity-selector">
            <view class="qty-btn {{item.quantity <= 1 ? 'disabled' : ''}}" catchtap="decreaseItemQuantity" data-index="{{index}}">
              <text>-</text>
            </view>
            <view class="qty-value">{{item.quantity}}</view>
            <view class="qty-btn" catchtap="increaseItemQuantity" data-index="{{index}}">
              <text>+</text>
            </view>
          </view>
        </view>
        <view class="item-row" wx:if="{{item.spec}}">
          <text class="item-label">规格</text>
          <input class="item-input" placeholder="请输入规格（如：大份/中辣）" value="{{item.spec}}" bindinput="onSpecInput" data-index="{{index}}" />
        </view>
      </view>
    </view>
    <text class="form-hint" wx:if="{{items.length === 0}}">暂无商品，请添加套餐包含的商品</text>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-bar">
    <button class="submit-btn" bindtap="handleSubmit" loading="{{loading}}">{{packageId ? '保存修改' : '发布套餐'}}</button>
  </view>
</view>
