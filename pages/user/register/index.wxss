/* pages/user/register/index.wxss */
.register-page {
  min-height: 100vh;
  background: var(--bg-gray);
  padding: 80rpx 32rpx;
}

/* Logo区域 */
.logo-section {
  text-align: center;
  margin-bottom: 48rpx;
}

.logo-container {
  width: 144rpx;
  height: 144rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  margin: 0 auto 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(255, 107, 0, 0.3);
}

.welcome-text {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-dark);
  margin-bottom: 8rpx;
}

.welcome-subtext {
  font-size: 26rpx;
  color: var(--text-gray);
}

/* 角色选择 */
.role-section {
  margin-bottom: 48rpx;
}

.role-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-dark);
  margin-bottom: 24rpx;
  text-align: center;
}

.role-cards {
  display: flex;
  gap: 24rpx;
}

.role-card {
  flex: 1;
  background: white;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  border: 3rpx solid transparent;
  transition: all 0.3s;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.role-card.active {
  border-color: var(--primary);
  background: linear-gradient(135deg, #FFF5F0 0%, #FFE8D9 100%);
}

.role-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin: 0 auto 16rpx;
  transition: all 0.3s;
}

.role-card.user .role-icon {
  background: linear-gradient(135deg, #FFE5CC 0%, #FFCC99 100%);
}

.role-card.merchant .role-icon {
  background: linear-gradient(135deg, #E5CCFF 0%, #D4B3FF 100%);
}

.role-card.active .role-icon {
  transform: scale(1.1);
}

.role-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-dark);
  margin-bottom: 4rpx;
}

.role-desc {
  font-size: 22rpx;
  color: var(--text-gray);
}

/* 表单卡片 */
.form-card {
  background: white;
  border-radius: 32rpx;
  padding: 48rpx 32rpx;
  margin-bottom: 32rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-dark);
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--bg-gray);
  border-radius: 16rpx;
  font-size: 28rpx;
}

.register-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: white;
  border: none;
  margin-top: 24rpx;
}

/* 登录提示 */
.login-tip {
  text-align: center;
  font-size: 28rpx;
  color: var(--text-gray);
}

.login-tip .link {
  color: var(--primary);
  font-weight: 600;
}
