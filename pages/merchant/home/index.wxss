/* pages/merchant/home/index.wxss */
.merchant-home-page {
  min-height: 100vh;
  background: var(--bg-gray);
  padding-bottom: 32rpx;
}

/* 商家头部 */
.merchant-header {
  background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
  padding: 48rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.merchant-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: white;
}

.merchant-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.merchant-name {
  font-size: 32rpx;
  font-weight: 700;
  color: white;
}

.merchant-type {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.header-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 12rpx 24rpx;
  background: white;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: var(--primary);
  cursor: pointer;
  position: relative;
  z-index: 10;
}

.logout-btn {
  background: rgba(255, 255, 255, 0.2);
  color: white;
}

/* 数据统计 */
.stats-card {
  background: white;
  margin: 24rpx 32rpx;
  border-radius: 16rpx;
  padding: 32rpx;
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary);
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-gray);
}

/* 快捷入口 */
.quick-entry {
  background: white;
  margin: 0 32rpx 24rpx;
  border-radius: 16rpx;
  padding: 32rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
}

.entry-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  z-index: 10;
}

.entry-icon {
  font-size: 64rpx;
}

.entry-label {
  font-size: 24rpx;
  color: var(--text-dark);
}

.entry-badge {
  position: absolute;
  top: -8rpx;
  right: 8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: var(--danger);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: white;
}

/* 待处理事项 */
.pending-section {
  background: white;
  margin: 0 32rpx;
  border-radius: 16rpx;
  padding: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-dark);
}

.section-more {
  font-size: 24rpx;
  color: var(--text-gray);
}

.pending-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.pending-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: var(--bg-gray);
  border-radius: 12rpx;
}

.pending-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.pending-user {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-dark);
}

.pending-time {
  font-size: 22rpx;
  color: var(--text-gray);
}

.pending-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary);
}

.pending-amount::before {
  content: '¥';
  font-size: 20rpx;
  margin-right: 2rpx;
}
