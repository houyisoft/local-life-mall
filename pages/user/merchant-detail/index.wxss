/* pages/user/merchant-detail/index.wxss */
.merchant-detail-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF9F5 0%, #F7F8FA 15%);
  padding-bottom: 140rpx;
  padding-bottom: calc(140rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* 商铺头部信息 */
.merchant-header {
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF8 100%);
  padding: 36rpx 28rpx;
  display: flex;
  gap: 28rpx;
  margin: 20rpx 24rpx;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 0, 0.08);
}

.merchant-logo {
  width: 180rpx;
  height: 180rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #FFE8D9 0%, #FFD6C2 100%);
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 0, 0.15);
}

.merchant-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.merchant-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.merchant-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1A;
  flex: 1;
}

.merchant-type {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  border-radius: 32rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 0, 0.2);
}

.type-icon {
  font-size: 26rpx;
}

.type-name {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.merchant-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.merchant-stats {
  display: flex;
  gap: 56rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 6rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #FF6B00;
  font-weight: 500;
}

/* 联系方式 */
.contact-section {
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF8 100%);
  padding: 0 28rpx;
  margin: 0 24rpx 20rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 0, 0.06);
}

.contact-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #FFF5F0;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-icon {
  font-size: 36rpx;
}

.contact-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 商品列表标题 */
.products-header {
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF8 100%);
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 0, 0.06);
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.product-count {
  font-size: 26rpx;
  color: #FF6B00;
  font-weight: 500;
}

/* 商品列表 */
.products-list {
  padding: 24rpx 24rpx 0;
}

.product-item {
  display: flex;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF8 100%);
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  border: 3rpx solid #FFE8D9;
  transition: all 0.3s;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 0, 0.08);
}

.product-item:active {
  transform: scale(0.98);
  border-color: #FF6B00;
}

.product-image {
  width: 220rpx;
  height: 220rpx;
  background: linear-gradient(135deg, #FFE8D9 0%, #FFD6C2 100%);
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.product-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-status {
  padding: 6rpx 16rpx;
  background: #F0F0F0;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #999;
  flex-shrink: 0;
}

/* 套餐徽章 */
.package-badge {
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  border-radius: 12rpx;
  font-size: 22rpx;
  color: white;
  font-weight: 600;
  flex-shrink: 0;
  box-shadow: 0 4rpx 8rpx rgba(255, 107, 0, 0.2);
}

.product-desc {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.product-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.price-symbol {
  font-size: 26rpx;
  color: #FF6B00;
  font-weight: 600;
}

.price-value {
  font-size: 40rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.original-price {
  font-size: 24rpx;
  color: #CCC;
  text-decoration: line-through;
}

.product-stats {
  display: flex;
  gap: 20rpx;
}

.sales-text,
.stock-text {
  font-size: 24rpx;
  color: #999;
}

.stock-text {
  color: #FF6B00;
  font-weight: 500;
}

/* 加载状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 120rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #FF6B00;
  font-weight: 500;
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  color: #FF6B00;
  font-weight: 500;
}

/* 加载更多 */
.load-more {
  padding: 32rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #FF6B00;
  font-weight: 500;
}

/* ==================== 购物车数量选择器 ==================== */

/* 购物车数量选择器容器 - 使用相对定位作为绝对定位的参照 */
.cart-quantity-wrapper {
  position: relative;
  flex-shrink: 0;
  width: 160rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

/* + 按钮（未添加时） - 绝对定位防止抖动 */
.add-to-cart-btn {
  position: absolute;
  right: 0;
  top: 0;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 0, 0.35);
  transition: all 0.3s;
}

.add-to-cart-btn.adding {
  opacity: 0.6;
  transform: scale(0.95);
}

.add-to-cart-btn:active {
  transform: scale(0.9);
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 0, 0.3);
}

.add-icon {
  font-size: 32rpx;
  color: white;
  font-weight: 600;
  line-height: 1;
}

/* 迷你数量选择器（已添加时） - 绝对定位防止抖动 */
.quantity-control-mini {
  position: absolute;
  right: 0;
  top: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #FFF5F0 0%, #FFE8D9 100%);
  border-radius: 28rpx;
  padding: 6rpx 14rpx;
  height: 52rpx;
  box-sizing: border-box;
  border: 2rpx solid #FF6B00;
}

.qty-btn-minus,
.qty-btn-plus {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: white;
  font-weight: 600;
  flex-shrink: 0;
  box-shadow: 0 4rpx 8rpx rgba(255, 107, 0, 0.2);
}

.qty-btn-minus:active,
.qty-btn-plus:active {
  transform: scale(0.95);
}

.qty-value {
  min-width: 40rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #FF6B00;
}

/* ==================== 底部购物车操作栏 ==================== */

/* 底部购物车操作栏 */
.cart-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF8 100%);
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 24rpx rgba(255, 107, 0, 0.1);
  z-index: 100;
  border-top: 3rpx solid #FFE8D9;
}

.cart-bar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

/* 购物车图标区域 */
.cart-icon-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 8rpx 0;
}

.cart-icon-container {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  border-radius: 50rpx 50rpx 50rpx 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 28rpx rgba(255, 107, 0, 0.35);
}

.cart-icon {
  font-size: 52rpx;
}

.cart-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  min-width: 44rpx;
  height: 44rpx;
  padding: 0 12rpx;
  background: linear-gradient(135deg, #FF4444 0%, #FF6666 100%);
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: white;
  border: 4rpx solid white;
  box-shadow: 0 4rpx 12rpx rgba(255, 68, 68, 0.3);
}

/* 价格显示 */
.cart-price {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.price-label {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.cart-price .price-symbol {
  font-size: 26rpx;
  color: #FF6B00;
  font-weight: 700;
}

.cart-price .price-value {
  font-size: 44rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* 去结算按钮 */
.checkout-btn {
  width: 260rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  color: white;
  border: none;
  box-shadow: 0 10rpx 28rpx rgba(255, 107, 0, 0.35);
  transition: all 0.3s;
}

.checkout-btn::after {
  border: none;
}

.checkout-btn:active {
  transform: scale(0.95);
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 0, 0.3);
}
