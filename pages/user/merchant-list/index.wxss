/* pages/user/merchant-list/index.wxss */
.merchant-list-page {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 商铺列表 */
.merchant-list {
  padding: 24rpx;
}

.merchant-item {
  display: flex;
  background: white;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.merchant-logo {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  background: #EEE;
}

.merchant-info {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.merchant-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.merchant-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}

.merchant-type {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 12rpx;
  background: #FFF5F0;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.type-icon {
  font-size: 24rpx;
}

.type-name {
  font-size: 22rpx;
  color: #FF6B00;
}

.merchant-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.merchant-footer {
  display: flex;
  align-items: center;
}

.merchant-address {
  font-size: 24rpx;
  color: #999;
}

/* 加载状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 120rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载更多 */
.load-more {
  padding: 32rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}
