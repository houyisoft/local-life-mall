/* pages/user/orders/index.wxss */
.orders-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF9F5 0%, #F7F8FA 15%);
}

/* 订单筛选 */
.tabs {
  display: flex;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF8 100%);
  padding: 24rpx 32rpx;
  gap: 48rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 0, 0.06);
}

.tab-item {
  font-size: 30rpx;
  color: #999;
  position: relative;
  padding-bottom: 12rpx;
  font-weight: 500;
  transition: all 0.3s;
}

.tab-item.active {
  color: #FF6B00;
  font-weight: 700;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  border-radius: 3rpx;
  box-shadow: 0 4rpx 8rpx rgba(255, 107, 0, 0.3);
}

/* 订单列表 */
.order-list {
  padding: 24rpx;
}

.order-card {
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF8 100%);
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 0, 0.08);
  border: 2rpx solid #FFE8D9;
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 2rpx solid #FFF5F0;
  background: linear-gradient(135deg, #FFFBF8 0%, #FFF9F5 100%);
}

.merchant-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.order-status {
  font-size: 26rpx;
  font-weight: 600;
}

.order-status.status-pending {
  color: #FF9500;
}

.order-status.status-paid {
  color: #FF6B00;
}

.order-status.status-accepted {
  color: #5856D6;
}

.order-status.status-shipped {
  color: #34C759;
}

.order-status.status-completed {
  color: #8E8E93;
}

.order-status.status-cancelled {
  color: #8E8E93;
}

/* 商品列表 */
.order-items {
  padding: 24rpx 32rpx;
}

.order-item {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.order-item:last-child {
  margin-bottom: 0;
}

.item-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 0, 0.1);
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.item-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.item-spec {
  font-size: 24rpx;
  color: #999;
  background: #FFF5F0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  display: inline-block;
}

.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-price {
  font-size: 32rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.item-price::before {
  content: '¥';
  font-size: 22rpx;
  margin-right: 2rpx;
}

.item-quantity {
  font-size: 26rpx;
  color: #999;
  font-weight: 500;
}

/* 订单底部 */
.order-footer {
  padding: 24rpx 32rpx;
  border-top: 2rpx solid #FFF5F0;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.order-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-time {
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
}

.order-total {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

.total-price {
  font-size: 36rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.order-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}

.action-btn {
  width: 180rpx;
  height: 68rpx;
  border-radius: 34rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.action-btn.secondary {
  background: linear-gradient(135deg, #FFF5F0 0%, #FFE8D9 100%);
  color: #FF6B00;
  border: 2rpx solid #FFE8D9;
}

.action-btn.primary {
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  color: white;
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 0, 0.3);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 160rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #FF6B00;
  font-weight: 500;
}
