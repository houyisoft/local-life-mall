/* pages/merchant/register/index.wxss */
.merchant-register-page {
  min-height: 100vh;
  background: var(--bg-gray);
  padding: 32rpx;
  padding-bottom: 120rpx;
}

.header {
  text-align: center;
  padding: 48rpx 0;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-dark);
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: var(--text-gray);
}

.form-item {
  background: white;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: var(--text-dark);
  margin-bottom: 24rpx;
  font-weight: 500;
}

.label.required::before {
  content: '*';
  color: var(--danger);
  margin-right: 4rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  font-size: 28rpx;
  color: var(--text-dark);
  background: var(--bg-gray);
  border-radius: 12rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  background: var(--bg-gray);
  border-radius: 12rpx;
  padding: 0 24rpx;
}

.picker-value {
  font-size: 28rpx;
  color: var(--text-dark);
}

.picker-value.placeholder {
  color: var(--text-gray);
}

.picker-icon {
  font-size: 40rpx;
  color: var(--text-gray);
  font-weight: 300;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  color: var(--text-dark);
  background: var(--bg-gray);
  border-radius: 12rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.logo-upload {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--bg-gray);
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-preview {
  width: 100%;
  height: 100%;
}

.logo-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.upload-icon {
  font-size: 48rpx;
  color: var(--text-gray);
}

.upload-text {
  font-size: 24rpx;
  color: var(--text-gray);
}

.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: white;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: var(--primary);
  color: white;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn[disabled] {
  opacity: 0.6;
}
