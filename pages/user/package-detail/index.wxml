<!--pages/user/package-detail/index.wxml-->
<view class="package-detail-page" wx:if="{{!loading}}">
  <!-- 套餐图片 -->
  <view class="image-section" bindtap="previewImage" data-url="{{packageDetail.images[0]}}">
    <image class="main-image" src="{{packageDetail.images[0]}}" mode="aspectFill"/>
  </view>

  <!-- 套餐信息 -->
  <view class="info-section">
    <view class="package-name">{{packageDetail.name}}</view>
    <view class="package-desc">{{packageDetail.description}}</view>

    <!-- 套餐内容 -->
    <view class="package-items" wx:if="{{packageDetail.items && packageDetail.items.length > 0}}">
      <view class="items-title">套餐包含</view>
      <view class="item-list">
        <view class="package-item" wx:for="{{packageDetail.items}}" wx:key="index" bindtap="goToProduct" data-id="{{item.productId}}">
          <image class="item-image" src="{{item.productImage}}" mode="aspectFill"/>
          <view class="item-info">
            <view class="item-name">{{item.productName}}</view>
            <view class="item-spec" wx:if="{{item.spec}}">规格：{{item.spec}}</view>
            <view class="item-price-row">
              <text class="item-price">¥{{item.productPrice / 100}}</text>
              <text class="item-quantity">x{{item.quantity}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 价格和数量 -->
    <view class="price-section">
      <view class="price-row">
        <text class="price-symbol">¥</text>
        <text class="price-value">{{packageDetail.price / 100}}</text>
        <text class="original-price" wx:if="{{packageDetail.originalPrice}}">¥{{packageDetail.originalPrice / 100}}</text>
      </view>

      <!-- 数量选择器 -->
      <view class="quantity-selector">
        <view class="qty-btn {{quantity <= 1 ? 'disabled' : ''}}" bindtap="decreaseQuantity">
          <text>-</text>
        </view>
        <view class="qty-value">{{quantity}}</view>
        <view class="qty-btn" bindtap="increaseQuantity">
          <text>+</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 商家信息 -->
  <view class="merchant-section" bindtap="goToMerchant">
    <view class="merchant-info">
      <text class="merchant-label">店铺</text>
      <text class="merchant-name">{{packageDetail.merchantName}}</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <!-- 套餐详情 -->
  <view class="detail-section" wx:if="{{packageDetail.details}}">
    <view class="detail-title">套餐详情</view>
    <view class="detail-content">{{packageDetail.details}}</view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="cart-icon" bindtap="goToCart">
      <text class="icon">🛒</text>
      <view class="badge" wx:if="{{cartCount > 0}}">{{cartCount}}</view>
    </view>
    <button class="add-cart-btn" bindtap="handleAddToCart">加入购物车</button>
    <button class="buy-now-btn" bindtap="handleBuyNow">立即购买</button>
  </view>
</view>

<!-- 加载中 -->
<view class="loading-container" wx:if="{{loading}}">
  <text class="loading-text">加载中...</text>
</view>
