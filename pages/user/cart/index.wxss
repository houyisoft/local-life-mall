/* pages/user/cart/index.wxss */
.cart-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF9F5 0%, #F7F8FA 15%);
  padding-bottom: 120rpx;
}

/* 购物车列表 */
.cart-list {
  padding: 24rpx;
}

.merchant-group {
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF8 100%);
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 0, 0.08);
  border: 2rpx solid #FFE8D9;
}

.merchant-header {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #FFF5F0;
  background: linear-gradient(135deg, #FFFBF8 0%, #FFF9F5 100%);
}

.merchant-checkbox {
  display: flex;
  align-items: center;
}

.merchant-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.cart-items {
  padding: 0 32rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 0;
  border-bottom: 2rpx solid #FFF5F0;
}

.cart-item:last-child {
  border-bottom: none;
}

.item-checkbox {
  display: flex;
  align-items: center;
}

.checkbox {
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid #FFD6C2;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: white;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.checkbox.checked {
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  border-color: #FF6B00;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 0, 0.3);
}

.item-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 0, 0.1);
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.item-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-spec {
  font-size: 24rpx;
  color: #999;
  background: #FFF5F0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  display: inline-block;
}

.item-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-price {
  font-size: 36rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.item-price::before {
  content: '¥';
  font-size: 24rpx;
  margin-right: 2rpx;
}

.item-stepper {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: linear-gradient(135deg, #FFF5F0 0%, #FFE8D9 100%);
  border-radius: 24rpx;
  padding: 6rpx;
  border: 2rpx solid #FFE8D9;
}

.stepper-btn {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: white;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  border-radius: 50%;
  font-weight: 600;
  box-shadow: 0 4rpx 8rpx rgba(255, 107, 0, 0.2);
}

.stepper-value {
  min-width: 60rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #FF6B00;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 160rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #FF6B00;
  font-weight: 500;
  margin-bottom: 48rpx;
}

.empty-btn {
  width: 220rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: white;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 0, 0.3);
}

/* 底部结算栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF8 100%);
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -8rpx 24rpx rgba(255, 107, 0, 0.1);
  border-top: 3rpx solid #FFE8D9;
}

.select-all {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.select-text {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
}

.bar-right {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.clear-btn {
  font-size: 26rpx;
  color: #999;
  padding: 8rpx 16rpx;
}

.total-section {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.total-price {
  font-size: 40rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.total-price::before {
  content: '¥';
  font-size: 26rpx;
  margin-right: 2rpx;
}

.checkout-btn {
  width: 220rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: white;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 0, 0.35);
}

.checkout-btn[disabled] {
  opacity: 0.4;
}
