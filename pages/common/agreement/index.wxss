/* pages/common/agreement/index.wxss */
.agreement-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

.header {
  background-color: #4A90E2;
  padding: 30rpx;
  text-align: center;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
}

.content {
  flex: 1;
  padding: 30rpx;
}

.agreement-content {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 40rpx;
}

.section {
  margin-bottom: 40rpx;
}

.section:last-child {
  margin-bottom: 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
}

.section-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
  margin-bottom: 16rpx;
  text-indent: 0;
}

.footer {
  padding: 20rpx;
  text-align: center;
  background-color: #f5f5f5;
}

.update-time {
  font-size: 24rpx;
  color: #999999;
}
