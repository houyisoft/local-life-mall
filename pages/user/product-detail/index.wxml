<!--pages/user/product-detail/index.wxml-->
<view class="product-detail-page" wx:if="{{product}}">
  <!-- 商品图片轮播 -->
  <view class="product-swiper-section">
    <swiper class="product-swiper" indicator-dots circular interval="3000" duration="500">
      <swiper-item wx:for="{{product.images}}" wx:key="index">
        <image class="product-swiper-image" src="{{item}}" mode="aspectFill" bindtap="previewImage" data-url="{{item}}" />
      </swiper-item>
    </swiper>

    <!-- 标签 -->
    <view class="product-tags-overlay">
      <text class="tag tag-hot" wx:if="{{product.tags && product.tags.includes('hot')}}">🔥热卖</text>
      <text class="tag tag-new" wx:if="{{product.tags && product.tags.includes('new')}}">✨新品</text>
      <text class="tag tag-discount" wx:if="{{product.tags && product.tags.includes('discount')}}">{{product.originalPrice ? Math.floor((1 - product.price/product.originalPrice) * 10) / 10 * 10 + '折' : ''}}</text>
    </view>
  </view>

  <!-- 商品基本信息 -->
  <view class="product-info-card">
    <view class="price-section">
      <text class="price">{{product.price / 100}}</text>
      <text class="original-price" wx:if="{{product.originalPrice}}">¥{{product.originalPrice / 100}}</text>
      <view class="sales-info">
        <text>销量 {{product.sales}}</text>
        <text>库存 {{product.stock}}</text>
      </view>
    </view>
    <view class="product-name">{{product.name}}</view>
    <view class="product-desc">{{product.desc}}</view>
  </view>

  <!-- 商家信息 -->
  <view class="merchant-card" bindtap="goToMerchant">
    <view class="merchant-info">
      <image class="merchant-avatar" src="https://picsum.photos/100/100?random=401" />
      <view class="merchant-detail">
        <view class="merchant-name">{{product.merchantName}}</view>
        <view class="merchant-desc">品质保证 · 售后无忧</view>
      </view>
    </view>
    <text class="merchant-arrow">›</text>
  </view>

  <!-- 规格选择 -->
  <view class="spec-card" wx:if="{{product.specs && product.specs.length > 0}}">
    <view class="spec-title">规格选择</view>
    <view class="spec-list">
      <view class="spec-group" wx:for="{{product.specs}}" wx:key="name" wx:for-index="specIndex">
        <view class="spec-name">{{item.name}}</view>
        <view class="spec-options">
          <view
            class="spec-option {{selectedSpecs[specIndex] === (option.name || option) ? 'active' : ''}}"
            wx:for="{{item.options}}"
            wx:for-item="option"
            wx:key="name"
            bindtap="selectSpec"
            data-spec-index="{{specIndex}}"
            data-option="{{option}}"
          >
            {{option.name || option}}
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 数量选择 -->
  <view class="quantity-card">
    <view class="quantity-title">购买数量</view>
    <view class="quantity-selector">
      <view class="quantity-btn {{quantity <= 1 ? 'disabled' : ''}}" bindtap="decreaseQuantity">
        <text>-</text>
      </view>
      <view class="quantity-value">{{quantity}}</view>
      <view class="quantity-btn {{quantity >= product.stock ? 'disabled' : ''}}" bindtap="increaseQuantity">
        <text>+</text>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="bar-icons">
      <view class="bar-icon" bindtap="goToCart">
        <text class="icon">🛒</text>
        <text class="icon-text">购物车</text>
        <view class="badge" wx:if="{{cartCount > 0}}">{{cartCount > 99 ? '99+' : cartCount}}</view>
      </view>
    </view>
    <view class="bar-buttons">
      <button class="bar-btn bar-btn-secondary" bindtap="handleAddToCart">加入购物车</button>
      <button class="bar-btn bar-btn-primary" bindtap="handleBuyNow">立即购买</button>
    </view>
  </view>
</view>

<!-- 空状态 -->
<view class="empty-state" wx:if="{{!product && !loading}}">
  <text class="empty-icon">📦</text>
  <text class="empty-text">商品不存在2</text>
</view>
