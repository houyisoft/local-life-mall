<!--pages/merchant/orders/index.wxml-->
<view class="orders-page">
  <!-- 订单筛选 -->
  <view class="tabs">
    <view class="tab-item {{activeTab === 'all' ? 'active' : ''}}" bindtap="switchTab" data-tab="all">全部</view>
    <view class="tab-item {{activeTab === 'paid' ? 'active' : ''}}" bindtap="switchTab" data-tab="paid">待接单</view>
    <view class="tab-item {{activeTab === 'shipped' ? 'active' : ''}}" bindtap="switchTab" data-tab="shipped">配送中</view>
    <view class="tab-item {{activeTab === 'completed' ? 'active' : ''}}" bindtap="switchTab" data-tab="completed">已完成</view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list" wx:if="{{orderList.length > 0}}">
    <view class="order-card" wx:for="{{orderList}}" wx:key="orderId">
      <!-- 订单头部 -->
      <view class="order-header">
        <text class="order-no">订单号：{{item.orderNo}}</text>
        <text class="order-status status-{{item.status}}">
          {{item.status === 'paid' ? '待接单' : item.status === 'accepted' ? '制作中' : item.status === 'shipped' ? '配送中' : item.status === 'completed' ? '已完成' : '已取消'}}
        </text>
      </view>

      <!-- 商品信息 -->
      <view class="order-products">
        <view class="product-item" wx:for="{{item.products}}" wx:for-item="product" wx:key="productName">
          <image class="product-image" src="{{product.productImage}}" mode="aspectFill" />
          <view class="product-info">
            <text class="product-name">{{product.productName}}</text>
            <view class="product-spec-qty">
              <text class="spec" wx:if="{{product.spec}}">{{product.spec}}</text>
              <text class="qty">x{{product.quantity}}</text>
            </view>
          </view>
          <text class="product-price">¥{{product.price / 100}}</text>
        </view>
      </view>

      <!-- 收货地址 -->
      <view class="order-address">
        <text class="address-icon">📍</text>
        <view class="address-info">
          <text class="receiver">{{item.receiverName}} {{item.receiverPhone}}</text>
          <text class="address">{{item.receiverAddress}}</text>
        </view>
      </view>

      <!-- 订单信息 -->
      <view class="order-info">
        <view class="info-row">
          <text class="label">下单时间</text>
          <text class="value">{{item.createTime}}</text>
        </view>
        <view class="info-row" wx:if="{{item.payTime}}">
          <text class="label">支付时间</text>
          <text class="value">{{item.payTime}}</text>
        </view>
      </view>

      <!-- 订单金额 -->
      <view class="order-amount">
        <text class="amount-label">订单金额</text>
        <text class="amount-value">¥{{item.actualPrice / 100}}</text>
      </view>

      <!-- 操作按钮 -->
      <view class="order-actions">
        <button class="action-btn reject" wx:if="{{item.status === 'paid'}}" catchtap="rejectOrder" data-order-no="{{item.orderNo}}">拒单</button>
        <button class="action-btn accept" wx:if="{{item.status === 'paid'}}" catchtap="acceptOrder" data-order-no="{{item.orderNo}}">接单</button>
        <button class="action-btn complete" wx:if="{{item.status === 'shipped'}}" catchtap="completeOrder" data-order-no="{{item.orderNo}}">完成</button>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{orderList.length === 0 && !loading}}">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无订单</text>
  </view>
</view>
