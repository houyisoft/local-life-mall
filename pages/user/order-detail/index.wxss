/* pages/user/order-detail/index.wxss */
.order-detail-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF9F5 0%, #F7F8FA 15%);
  padding-bottom: 120rpx;
}

/* 状态卡片 */
.status-card {
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 12rpx 32rpx rgba(255, 107, 0, 0.25);
}

.status-icon image {
  width: 100rpx;
  height: 100rpx;
}

.status-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-top: 24rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.status-tips {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 12rpx;
  font-weight: 500;
}

/* 通用区块 */
.section {
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF8 100%);
  margin: 20rpx 24rpx;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 0, 0.08);
  border: 2rpx solid #FFE8D9;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  color: #1A1A1A;
}

.section-title .icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

/* 收货地址 */
.address-detail {
  padding: 10rpx 0;
}

.address-name-phone {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.address-name-phone .name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-right: 20rpx;
}

.address-name-phone .phone {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.address-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* 商品列表 */
.product-list {
  margin-top: 10rpx;
}

.product-item {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #FFF5F0;
}

.product-item:last-child {
  border-bottom: none;
}

.product-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 0, 0.1);
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: 700;
  line-height: 1.4;
}

.product-spec {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  background: #FFF5F0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  display: inline-block;
}

.product-price-qty {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.product-price-qty .price {
  font-size: 36rpx;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-weight: 700;
}

.product-price-qty .qty {
  font-size: 28rpx;
  color: #999;
  font-weight: 500;
}

/* 订单信息 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #FFF5F0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-row .label {
  font-size: 28rpx;
  color: #999;
  font-weight: 500;
}

.info-row .value {
  font-size: 28rpx;
  color: #333;
  text-align: right;
  max-width: 400rpx;
  font-weight: 500;
}

.value-with-copy {
  display: flex;
  align-items: center;
}

.copy-btn {
  font-size: 24rpx;
  color: #FF6B00;
  margin-left: 10rpx;
  padding: 6rpx 16rpx;
  background: #FFF5F0;
  border-radius: 12rpx;
  font-weight: 500;
}

/* 价格明细 */
.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.price-row .label {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.price-row .value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.price-row .value.discount {
  color: #FF6B00;
  font-weight: 700;
}

.price-row.total {
  border-top: 2rpx solid #FFF5F0;
  margin-top: 20rpx;
  padding-top: 20rpx;
}

.price-row.total .label {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.price-row.total .value {
  font-size: 40rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.price-row.total .value.highlight {
  font-size: 44rpx;
}

/* 底部操作栏 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF8 100%);
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 24rpx rgba(255, 107, 0, 0.1);
  border-top: 3rpx solid #FFE8D9;
}

.action-buttons {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 16rpx;
}

.btn {
  padding: 18rpx 44rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  line-height: 1;
  font-weight: 600;
}

.btn-default {
  background: linear-gradient(135deg, #FFF5F0 0%, #FFE8D9 100%);
  color: #FF6B00;
  border: 2rpx solid #FFE8D9;
}

.btn-primary {
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  color: #fff;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 0, 0.3);
}

/* 商家详情弹窗 */
.merchant-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: relative;
  width: 100%;
  max-height: 80vh;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF8 100%);
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid #FFF5F0;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.modal-close {
  font-size: 60rpx;
  color: #FFD6C2;
  line-height: 1;
  padding: 0 10rpx;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 32rpx;
}

.merchant-header {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.merchant-logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 20rpx;
  margin-right: 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 0, 0.15);
}

.merchant-info {
  flex: 1;
}

.merchant-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 12rpx;
}

.merchant-type {
  font-size: 26rpx;
  color: #FF6B00;
  background: linear-gradient(135deg, #FFF5F0 0%, #FFE8D9 100%);
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  display: inline-block;
  font-weight: 600;
}

.info-section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  font-size: 28rpx;
}

.info-row .label {
  color: #999;
  min-width: 160rpx;
  font-weight: 500;
}

.info-row .value {
  flex: 1;
  color: #333;
  line-height: 1.6;
  font-weight: 500;
}

.info-row .value.phone {
  color: #FF6B00;
  font-weight: 700;
}

.description {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.modal-footer {
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #FFF5F0;
}

.btn-call {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 28rpx rgba(255, 107, 0, 0.35);
}

.btn-call::after {
  border: none;
}
