<!--pages/user/register/index.wxml-->
<view class="register-page">
  <!-- Logo区域 -->
  <view class="logo-section">
    <view class="logo-container">🛒</view>
    <view class="welcome-text">欢迎加入</view>
    <view class="welcome-subtext">开启您的本地生活之旅</view>
  </view>

  <!-- 角色选择 -->
  <view class="role-section">
    <view class="role-title">选择您的身份</view>
    <view class="role-cards">
      <view class="role-card user {{selectedRole === 'user' ? 'active' : ''}}" bindtap="selectRole" data-role="user">
        <view class="role-icon">👤</view>
        <view class="role-name">用户</view>
        <view class="role-desc">购物下单</view>
      </view>
      <view class="role-card merchant {{selectedRole === 'merchant' ? 'active' : ''}}" bindtap="selectRole" data-role="merchant">
        <view class="role-icon">🏪</view>
        <view class="role-name">自营商家</view>
        <view class="role-desc">管理店铺</view>
      </view>
    </view>
  </view>

  <!-- 注册表单 -->
  <view class="form-card">
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" placeholder="请输入手机号" maxlength="11" value="{{phone}}" bindinput="onPhoneInput" />
    </view>

    <view class="form-item">
      <text class="form-label">密码</text>
      <input class="form-input" type="text" placeholder="请设置密码（至少6位）" password value="{{password}}" bindinput="onPasswordInput" />
    </view>

    <view class="form-item">
      <text class="form-label">昵称</text>
      <input class="form-input" placeholder="请输入昵称" value="{{nickname}}" bindinput="onNicknameInput" />
    </view>

    <button class="register-btn" bindtap="handleRegister" loading="{{loading}}">立即注册</button>
  </view>

  <!-- 登录提示 -->
  <view class="login-tip">
    已有账号？<text class="link" bindtap="goToLogin">立即登录</text>
  </view>
</view>
