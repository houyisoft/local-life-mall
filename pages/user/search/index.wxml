<!--pages/user/search/index.wxml-->
<view class="search-page">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索商品" value="{{keyword}}" focus="{{true}}" bindinput="onInput" bindconfirm="onSearch" />
      <text class="clear-icon" wx:if="{{keyword}}" bindtap="onClear">✕</text>
    </view>
    <text class="cancel-btn" bindtap="onCancel">取消</text>
  </view>

  <!-- 搜索结果 -->
  <view class="search-result" wx:if="{{searched}}">
    <view class="product-list" wx:if="{{products.length > 0}}">
      <view class="product-item" wx:for="{{products}}" wx:key="id" bindtap="goToProductDetail" data-id="{{item.id}}">
        <image class="product-image" src="{{item.images && item.images.length > 0 ? item.images[0] : ''}}" mode="aspectFill" />
        <view class="product-info">
          <text class="product-name">{{item.name}}</text>
          <text class="product-desc">{{item.desc}}</text>
          <view class="product-footer">
            <text class="product-price">{{item.price / 100}}</text>
            <text class="product-sales">已售{{item.sales}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{products.length === 0 && !loading}}">
      <text class="empty-icon">🔍</text>
      <text class="empty-text">没有找到相关商品</text>
    </view>
  </view>

  <!-- 搜索推荐 -->
  <view class="search-recommend" wx:if="{{!searched}}">
    <!-- 搜索历史 -->
    <view class="history-section" wx:if="{{history.length > 0}}">
      <view class="section-header">
        <text class="section-title">搜索历史</text>
        <text class="clear-btn" bindtap="clearHistory">清空</text>
      </view>
      <view class="history-list">
        <text class="history-item" wx:for="{{history}}" wx:key="index" bindtap="searchHistory" data-keyword="{{item}}">{{item}}</text>
      </view>
    </view>

    <!-- 热门搜索 -->
    <view class="hot-section">
      <view class="section-header">
        <text class="section-title">热门搜索</text>
      </view>
      <view class="hot-list">
        <text class="hot-item" wx:for="{{hotSearch}}" wx:key="index" bindtap="searchHot" data-keyword="{{item}}">{{item}}</text>
      </view>
    </view>
  </view>
</view>
