/* pages/merchant/products/index.wxss */
.products-page {
  min-height: 100vh;
  background: var(--bg-gray);
  padding-bottom: 32rpx;
}

/* 顶部操作栏 */
.top-bar {
  background: white;
  padding: 24rpx 32rpx;
}

.tabs {
  display: flex;
  gap: 48rpx;
  margin-bottom: 24rpx;
}

.tab-item {
  font-size: 28rpx;
  color: var(--text-gray);
  position: relative;
  padding-bottom: 8rpx;
}

.tab-item.active {
  color: var(--primary);
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: var(--primary);
  border-radius: 2rpx;
}

.add-btn {
  width: 100%;
  height: 80rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: white;
  border: none;
}

/* 商品列表 */
.product-list {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.product-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  gap: 24rpx;
}

.product-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.product-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-dark);
}

.product-price {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary);
}

.product-meta {
  display: flex;
  gap: 24rpx;
}

.meta-item {
  font-size: 24rpx;
  color: var(--text-gray);
}

.product-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  justify-content: center;
}

.action-btn {
  width: 120rpx;
  height: 56rpx;
  background: var(--bg-gray);
  border-radius: 8rpx;
  font-size: 24rpx;
  color: var(--text-dark);
  border: none;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-gray);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 160rpx;
  margin-bottom: 32rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-gray);
  margin-bottom: 48rpx;
}

.empty-btn {
  width: 200rpx;
  height: 72rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
  border-radius: 36rpx;
  font-size: 28rpx;
  color: white;
  border: none;
}
